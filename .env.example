# Salin file ini menjadi .env lalu isi dari Dashboard Supabase.
# Settings / API atau Integrations / Data API.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Gunakan SECRET key/server-side key. JANGAN taruh key ini di public/app.js atau index.html.
# Untuk project lama, SUPABASE_SERVICE_ROLE_KEY juga didukung.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
